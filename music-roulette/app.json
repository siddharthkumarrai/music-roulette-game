{
  "expo": {
    "name": "Music Roulette",
    "slug": "music-roulette",
    "owner": "siddharthkumarrais-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12111A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.siddharthkumarrai.musicroulette",
      "supportsTablet": false
    },
    "android": {
      "package": "com.siddharthkumarrai.musicroulette",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12111A"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1e56ea31-9bad-4dc6-a022-5c2b55f035b2"
      }
    }
  }
}