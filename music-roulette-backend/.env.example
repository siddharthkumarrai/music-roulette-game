PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/music-roulette?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:19006,http://localhost:8081

CRON_CHECK_INTERVAL_MINUTES=60

# Cloudinary — audio files are uploaded here instead of local disk
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Base64-encoded cookies.txt for yt-dlp to bypass YouTube bot detection
# Export from browser using a cookies.txt extension, then base64-encode the file
YOUTUBE_COOKIES_BASE64=
